<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NBMS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nbms_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.NBMS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A1733</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_art</item>
        <item name="postSplashScreenTheme">@style/Theme.NBMS</item>
    </style>
</resources>
